<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PanicButton" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme applied on cold start -->
    <style name="Theme.PanicButton.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0E27</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.PanicButton</item>
    </style>

</resources>